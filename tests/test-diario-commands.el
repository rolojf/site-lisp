(ert-deftest my-diario-commands-retry-with-task-receipts ()
  (my-dct-test--with-files
    (let ((real-save (symbol-function 'my-diario--save))
          (failed nil))
      (cl-letf (((symbol-function 'denote)
                 (lambda (&rest _args)
                   (with-temp-file target (insert my-dct-test--fresh)) target))
                ((symbol-function 'my-diario--save)
                 (lambda (path before text)
                   (when (and (equal path target) (not failed))
                     (setq failed t)
                     (error "Injected target save failure"))
                   (funcall real-save path before text))))
        (should-error (my-diario-today)))
      (should (string-match-p "DIARIO_ROLL_TO" (my-dct-test--text source)))
      (should-not (string-match-p "TODO Trabajo" (my-dct-test--text target)))
      (should (= 1 (plist-get (my-diario-today) :moved)))
      (should (string-match-p "TODO Trabajo" (my-dct-test--text target)))
      (should-not (string-match-p "TODO Trabajo" (my-dct-test--text source))))))

(ert-deftest my-diario-commands-recover-ot-notes-without-task-receipt ()
  (my-dct-test--with-files
    (with-temp-file source
      (insert "#+title: Ayer\n#+identifier: 20260601T1100\n\n* OPORTUNIDADES Y AMENAZAS\n** Empresa\n*** TODO OT sin tarea :cliente_003:\n** Contratista\n* DEEP\n* SHALLOW\n* Notas\nContexto que viaja.\n"))
    (let ((save (symbol-function 'my-diario--save))
          (failed nil)
          (created 0))
      (cl-letf (((symbol-function 'denote)
                 (lambda (&rest _args)
                   (cl-incf created)
                   (with-temp-file target (insert my-dct-test--fresh)) target))
                ((symbol-function 'my-diario--save)
                 (lambda (file before content)
                   (when (and (equal file target) (not failed))
                     (setq failed t)
                     (error "Injected first target write failure"))
                   (funcall save file before content))))
        (should-error (my-diario-today)))
      (should (= 1 created))
      (should-not (string-match-p "DIARIO_ROLL_TO" (my-dct-test--text source)))
      (should (equal my-dct-test--fresh (my-dct-test--text target)))
      (let ((result (my-diario-today)))
        (should (= 1 (plist-get result :copied-ot)))
        (should (eq (plist-get result :mode) 'new)))
      (let ((new (my-dct-test--text target)))
        (should (= 1 (my-dct-test--count new "*** TODO OT sin tarea")))
        (should (= 1 (my-dct-test--count new "Contexto que viaja.")))
        (should (string-search "*** TODO OT sin tarea" (my-dct-test--text source)))
        (should (equal new (progn (my-diario-today) (my-dct-test--text target))))))))

