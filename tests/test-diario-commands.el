  (my-dct-test--with-files
    (with-temp-file later
      (insert "* TASKS\n** COLD OT :cliente_003:\nSCHEDULED: <2026-06-20 Sat>\n:PROPERTIES:\n:ID: unique-legacy-id\n:END:\nEnlace [[denote:20260511T1358]].\n*** Nota de OT\nTexto interior.\n** COLD Profundo\n** COLD Ligero\nSCHEDULED: <2026-06-02 Tue>\n"))
    (let ((answers '("OT Empresa" "DEEP" "SHALLOW"))
          (ids 0)
          (org-id-method 'ts)
          (original (my-dct-test--text later)))
      (with-current-buffer (find-file-noselect later)
        (setq buffer-undo-list nil)
        (cl-letf (((symbol-function 'completing-read)
                   (lambda (_prompt choices &rest _args)
                     (should (equal choices my-dmig--choices))
                     (pop answers)))
                  ((symbol-function 'org-id-new)
                   (lambda (&rest _args)
                     (should (eq org-id-method 'uuid))
                     (format "fixture-uuid-%s" (cl-incf ids))))
                  ((symbol-function 'pop-to-buffer)
                   (lambda (&rest _args)
                     (error "Noninteractive reconciliation changed windows"))))
          (should (eq (my-diario-reconcile-luego later "20260603") (current-buffer))))
        (should (null answers))
        (should (= ids 3))
        (should (eq org-id-method 'ts))
        (should (buffer-modified-p))
        (should (equal original (my-dct-test--text later)))
        (should (string-match-p "\\* LUEGO" (buffer-string)))
        (should (string-match-p "SCHEDULED: <2026-06-17" (buffer-string)))
        (should (string-match-p "SCHEDULED: <2026-06-20" (buffer-string)))
        (should (string-match-p "SCHEDULED: <2026-06-02" (buffer-string)))
        (should (string-match-p "unique-legacy-id" (buffer-string)))
        (should (string-match-p "Enlace \\[\\[denote:" (buffer-string)))
        (should (string-match-p "\\*\\*\\* Nota de OT" (buffer-string)))
        (my-diario--later-scan)
        (goto-char (point-min))
        (search-forward "** COLD OT")
        (should (equal (org-entry-get nil "DIARIO_ORIGIN_HASH")
                       (my-diario--origin-hash "fixture-uuid-1"
                                               "OPORTUNIDADES Y AMENAZAS" "Empresa")))
        (undo 1)
        (should (equal original (buffer-string)))))))

(ert-deftest my-diario-commands-interactive-luego-opens-edited-buffer ()
  (my-dct-test--with-files
    (with-temp-file later
      (insert "* TASKS\n** COLD Revisión\nSCHEDULED: <2026-06-20 Sat>\n"))
    (let (shown (displays 0))
      (cl-letf (((symbol-function 'completing-read)
                 (lambda (&rest _args) "SHALLOW"))
                ((symbol-function 'org-id-new)
                 (lambda (&rest _args) "fixture-uuid"))
                ((symbol-function 'pop-to-buffer)
                 (lambda (buffer &rest _args)
                   (setq shown buffer)
                   (cl-incf displays))))
        (let ((returned (call-interactively #'my-diario-reconcile-luego)))
          (should (eq shown returned))))
      (should (= displays 1))
      (with-current-buffer shown
        (should (buffer-modified-p))
        (should (string-match-p "^\\* LUEGO" (buffer-string))))
      (should (string-match-p "^\\* TASKS" (my-dct-test--text later))))))

(ert-deftest my-diario-commands-legacy-luego-rejects-partial-metadata ()
  (my-dct-test--with-files
    (with-temp-file later (insert "* TASKS\n** COLD Incompleto\n:PROPERTIES:\n:DIARIO_LIST: SHALLOW\n:END:\n"))
    (with-current-buffer (find-file-noselect later)
      (let ((before (buffer-string)))
        (should-error (my-diario-reconcile-luego later "20260603") :type 'user-error)
        (should (equal before (buffer-string)))
        (should-not (buffer-modified-p))))))

(ert-deftest my-diario-commands-future-luego-not-returned ()
  (my-dct-test--with-files
    (with-temp-file target (insert my-dct-test--ready))
    (my-dct-test--due later "2026-06-20 Sat")
    (should (= 0 (plist-get (my-diario-today) :returned)))
    (should-not (string-match-p "Esperando" (my-dct-test--text target)))
    (should (string-match-p "Esperando" (my-dct-test--text later)))))

(ert-deftest my-diario-commands-focus-scope-and-manual-activation ()
  (my-dct-test--with-files
    (let ((global-before (lookup-key (current-global-map) (kbd "C-c n f"))))
      (with-current-buffer (find-file-noselect source)
        (should-not my-diario-focus-mode)
        (my-diario-activate-focus)
        (should my-diario-focus-mode)
        (should (eq (key-binding (kbd "C-c n f")) #'my-diario-focus)))
      (with-temp-file target (insert my-dct-test--ready))
      (let ((org-mode-hook '(my-diario-activate-focus)))
        (with-current-buffer (find-file-noselect target)
          (should my-diario-focus-mode)
          (should (eq (key-binding (kbd "C-c n f")) #'my-diario-focus))))
      (let ((other (expand-file-name "other.org" dir)))
        (with-temp-file other (insert "* Otra nota\n"))
        (with-current-buffer (find-file-noselect other)
          (my-diario-activate-focus)
          (should-not my-diario-focus-mode)
          (should-not (eq (key-binding (kbd "C-c n f")) #'my-diario-focus))))
      (should (equal global-before (lookup-key (current-global-map)
                                               (kbd "C-c n f")))))))

