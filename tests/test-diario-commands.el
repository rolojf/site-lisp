(ert-deftest my-diario-commands-source-legacy-and-finish ()
  (my-dct-test--with-files
    (with-temp-file source
      (insert "#+title: Ayer\n#+identifier: 20260601T1100\n* TASKS\n** TODO Pendiente\n* Notas\nContexto.\n"))
    (let ((created 0))
      (cl-letf (((symbol-function 'denote)
                 (lambda (&rest _args) (cl-incf created))))
        (let ((reason (should-error (my-diario-today) :type 'user-error)))
          (should (string-match-p "my-diario-classify" (error-message-string reason)))))
      (should (= 0 created)))
    (with-current-buffer (find-file-noselect source)
      (should-error (my-diario-finish) :type 'user-error)
      (my-diario-prepare)
      (goto-char (point-min))
      (search-forward "** TODO Pendiente")
      (my-diario-classify "SHALLOW")
      (my-diario-finish)
      (should-not (string-match-p "\\* TASKS" (buffer-string)))
      (should (buffer-modified-p))
      (should (string-match-p "\\* TASKS" (my-dct-test--text source)))
      (should-error (my-diario-today) :type 'user-error)
      (save-buffer))
    (cl-letf (((symbol-function 'denote)
               (lambda (&rest _args)
                 (with-temp-file target (insert my-dct-test--fresh)) target)))
      (my-diario-today))
    (should (string-match-p "\\*\\* TODO Pendiente" (my-dct-test--text target)))
    (should-not (string-match-p "\\* TASKS" (my-dct-test--text target)))))

(ert-deftest my-diario-commands-finish-preserves-prose-and-undo ()
  (with-temp-buffer
    (let ((org-mode-hook nil)) (org-mode))
    (insert "* TASKS\nIdeas sin clasificar como entradas.\n* Notas\nOtro texto.\n")
    (setq buffer-undo-list nil)
    (let ((old (buffer-string)))
      (my-diario-finish)
      (should (string-match-p "Notas (antes TASKS)\nIdeas sin clasificar" (buffer-string)))
      (should (string-match-p "\\* Notas\nOtro texto" (buffer-string)))
      (undo 1)
      (should (equal old (buffer-string))))))

