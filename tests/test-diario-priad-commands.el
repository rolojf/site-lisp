(ert-deftest my-diario-priad-commands-active-root-discovery ()
  (my-dpc-test--files
    (let ((bad (expand-file-name "20260601T1300==p--sin-keywords.org" denote-directory))
          (archived (expand-file-name "20260601T1301==ap--viejo__cliente.org" denote-directory))
          (nested (expand-file-name "sub" denote-directory))
          (symlink (expand-file-name "20260601T1302==p--link__cliente.org" denote-directory)))
      (with-temp-file bad (insert "* Notas\n"))
      (with-temp-file archived (insert "* Notas\n"))
      (make-directory nested)
      (with-temp-file (expand-file-name "20260601T1303==r--nested__cliente.org" nested)
        (insert "* Notas\n"))
      (make-symbolic-link priad symlink)
      (should (equal (my-dpc--candidates) (list source priad)))
      (with-temp-file target (insert my-dpc-test--closed))
      (with-current-buffer (find-file-noselect target)
        (my-dpc-test--at "Cierre")
        (cl-letf (((symbol-function 'completing-read)
