      (cl-letf (((symbol-function 'my-diario-current) (lambda () target)))
        (should-error (my-dpc-copy 'new-only) :type 'user-error))
      (should (buffer-live-p visitor))
      (cl-letf (((symbol-function 'my-diario-current) (lambda () next))
                ((symbol-function 'completing-read)
                 (lambda (&rest _) (error "Retry asked for classification"))))
        (let ((this-command 'kill-buffer))
          (should (my-dpc-copy 'new-only))))
      (should-not (buffer-live-p visitor))
