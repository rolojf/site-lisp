(ert-deftest my-diario-priad-commands-user-close-and-background-close ()
  (my-dpc-test--files
    (let ((visitor (current-buffer))
          (kill-buffer-query-functions (list #'my-dpc-maybe-on-kill)))
      ;; Background closing must not even attempt a diario lookup.
      (cl-letf (((symbol-function 'my-diario-current)
                 (lambda () (error "Background hook attempted import"))))
        (let ((this-command nil))
          (should (kill-buffer visitor))))
      (should (equal (my-dpc-test--disk source) my-dpc-test--source)))
    (with-current-buffer (find-file-noselect source)
      (let ((visitor (current-buffer))
            (kill-buffer-query-functions (list #'my-dpc-maybe-on-kill)))
        (cl-letf (((symbol-function 'my-diario-current) (lambda () target))
                  ((symbol-function 'completing-read) (lambda (&rest _) "SHALLOW")))
          (let ((this-command 'kill-this-buffer))
            (should (kill-buffer visitor))))
        (should-not (buffer-live-p visitor))
        (should (string-search "** TODO Cotización" (my-dpc-test--disk target)))))))

