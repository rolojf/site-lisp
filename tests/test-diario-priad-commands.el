          (before (my-dpc-test--disk next))
          (kill-buffer-query-functions (list #'my-dpc-maybe-on-kill)))
      (cl-letf (((symbol-function 'my-diario-current) (lambda () next))
                ((symbol-function 'my-di--save-target)
