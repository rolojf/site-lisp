;;; test-diario-priad-commands.el --- Isolated PRIAD command fixtures -*- lexical-binding: t; -*-

;;; Commentary:
;; Never load setup-journaling or visit a live KB file.  Inspect its thin
;; wrappers as data; exercise the bridge against temporary Org visitors.

;;; Code:

(require 'cl-lib)
(require 'ert)
(require 'org)
(require 'diario-priad-commands)

(defvar denote-directory)
(defvar denote-journal-directory)
(defvar my-diario-customer-tags)
(defvar my-diario-ignored-tags)
(defvar my-dpc--inhibit-import)

(defconst my-dpc-test--setup
  (expand-file-name "setup-journaling.el"
                    (expand-file-name ".." (file-name-directory
                                           (or load-file-name buffer-file-name)))))
(defconst my-dpc-test--source
  "#+title: Cliente\n\n* Ideas :plan:\n** TODO Cotización :cliente_techo:\nContexto [[denote:20260511T1358]].\n*** TODO Paso interno\n")
(defconst my-dpc-test--diario
  "#+title: Hoy\n#+identifier: 20260603T0900\n\n* OPORTUNIDADES Y AMENAZAS\n** Empresa\n** Contratista\n* DEEP\n* SHALLOW\n* Notas\n")
(defconst my-dpc-test--closed
  "#+title: Hoy\n#+identifier: 20260603T0900\n\n* OPORTUNIDADES Y AMENAZAS\n** Empresa\n*** DONE Cierre :cliente_techo:\n*** COLD Aparcado :cliente_techo:\n** Contratista\n* DEEP\n** DONE Medir :cliente_techo:\n* SHALLOW\n** DONE Llamar :cliente_techo:\n* Notas\n** DONE Fuera :cliente_techo:\n")

(defmacro my-dpc-test--files (&rest body)
  "Run BODY in a saved PRIAD source with bounded disposable visitors."
  (declare (indent 0) (debug t))
  `(with-temp-buffer
     (let* ((sandbox (make-temp-file "diario-priad-commands-test-" t))
            (denote-directory (expand-file-name "priads" sandbox))
            (denote-journal-directory (expand-file-name "diario" denote-directory))
            (source (expand-file-name
                     "20260601T1200==p--cliente__cliente.org" denote-directory))
            (target (expand-file-name
                     "20260603T0900--hoy__journal.org" denote-journal-directory))
            (next (expand-file-name
                   "20260604T0900--manana__journal.org" denote-journal-directory))
            (priad (expand-file-name
                    "20260601T1201==r--cliente__cliente.org" denote-directory))
            (real-find (symbol-function 'find-file-noselect))
            (fixture-root denote-directory)
            (fixture-journal denote-journal-directory)
            (org-mode-hook nil)
            (find-file-hook nil)
            (kill-buffer-query-functions nil)
            (kill-buffer-hook nil)
            (org-todo-keywords '((sequence "TODO" "NEXT" "WAIT" "SDM"
                                          "COLD" "|" "DONE" "KILL")))
            (my-diario-customer-tags nil)
            (my-diario-ignored-tags
             (append my-diario-ignored-tags '("chulet" "adm" "alf" "techo")))
            (org-log-done nil)
            (org-log-into-drawer nil)
            (org-inhibit-startup t))
       (make-directory denote-journal-directory t)
       (unwind-protect
           (progn
             (with-temp-file source (insert my-dpc-test--source))
             (with-temp-file target (insert my-dpc-test--diario))
             (with-temp-file next (insert my-dpc-test--diario))
             (with-temp-file priad (insert "#+title: Cliente\n* Bitácora\nNotas.\n"))
             (cl-letf (((symbol-function 'find-file-noselect)
                        (lambda (file &rest args)
                          (unless (and (stringp file)
                                       (file-in-directory-p (expand-file-name file)
                                                            fixture-root))
                            (error "Fixture cannot visit %S" file))
                          (let ((visitor (apply real-find file args)))
                            (with-current-buffer visitor
                              (setq-local denote-directory fixture-root)
                              (setq-local denote-journal-directory
                                          fixture-journal))
                            visitor))))
               (with-current-buffer (find-file-noselect source)
                 (org-mode)
                 ,@body)))
         (dolist (file (directory-files denote-directory t "\\.org\\'"))
           (when-let* ((visitor (find-buffer-visiting file)))
             (with-current-buffer visitor
               (let ((my-dpc--inhibit-import t)
                     (kill-buffer-query-functions nil)
                     (kill-buffer-hook nil))
                 (set-buffer-modified-p nil)
                 (kill-buffer visitor)))))
         (dolist (file (directory-files denote-journal-directory t "\\.org\\'"))
           (when-let* ((visitor (find-buffer-visiting file)))
             (with-current-buffer visitor
               (let ((my-dpc--inhibit-import t)
                     (kill-buffer-query-functions nil)
                     (kill-buffer-hook nil))
                 (set-buffer-modified-p nil)
                 (kill-buffer visitor)))))
         (delete-directory sandbox t)))))

(defun my-dpc-test--disk (file)
  "Read fixture FILE without a visiting buffer."
  (with-temp-buffer (insert-file-contents file) (buffer-string)))

(defun my-dpc-test--at (heading)
  "Move to fixture HEADING."
  (goto-char (point-min))
  (re-search-forward (concat "^\\*+ .*" (regexp-quote heading)))
  (beginning-of-line))

(defun my-dpc-test--count (fragment text)
  "Count literal FRAGMENT in TEXT."
  (let ((start 0) (count 0))
    (while (string-match (regexp-quote fragment) text start)
      (cl-incf count)
      (setq start (match-end 0)))
    count))

(defun my-dpc-test--form (name)
  "Read a setup-journaling defun with NAME without loading its side effects."
  (with-temp-buffer
    (insert-file-contents my-dpc-test--setup)
    (goto-char (point-min))
    (re-search-forward (concat "^(defun " (regexp-quote (symbol-name name)) " "))
    (beginning-of-line)
    (read (current-buffer))))

(ert-deftest my-diario-priad-commands-public-wiring ()
  (dolist (pair '((my-copiar-a-tareas-diarias . my-dpc-copy)
                  (my-copiar-a-tareas-diarias--maybe-on-kill . my-dpc-maybe-on-kill)
                  (my-referir-pendientes . my-dpc-refer)
                  (my-denote-journal-today . my-diario-today)))
    (let ((form (my-dpc-test--form (car pair))))
      (should (memq (car pair) form))
      (should (memq (cdr pair) (flatten-tree form)))))
  (with-temp-buffer
    (insert-file-contents my-dpc-test--setup)
    (dolist (binding '(("C-c n c" . "my-copiar-a-tareas-diarias")
                       ("C-c n e" . "my-referir-pendientes")
                       ("C-c n j" . "my-denote-journal-today")
                       ("C-c n a" . "my-org-agenda-current-file")))
      (goto-char (point-min))
      (should (search-forward (concat "(kbd \"" (car binding) "\") #'"
                                      (cdr binding)) nil t)))
    (goto-char (point-min))
    (should (search-forward "(add-hook 'org-mode-hook #'my-diario-activate-focus)" nil t))
    (goto-char (point-min))
    (should (search-forward "(setq my-diario-ignored-tags" nil t)))
  (let* ((copy (my-dpc-test--form 'my-copiar-a-tareas-diarias))
         (wrapper (eval `(lambda ,(nth 2 copy) ,@(cdddr copy)) t))
         (policy nil))
    (should (equal (nth 4 copy)
                   '(interactive (list (if current-prefix-arg
                                           'repeat 'new-only)))))
    (cl-letf (((symbol-function 'my-dpc-copy)
               (lambda (argument) (setq policy argument) :delegated)))
      (should (eq (funcall wrapper 'repeat) :delegated))
      (should (eq policy 'repeat))
      (should (eq (funcall wrapper) :delegated))
      (should-not policy)))
  (let ((refer (my-dpc-test--form 'my-referir-pendientes)))
    (cl-letf (((symbol-function 'my-dpc-refer) (lambda () :delegated)))
      (should (eq (funcall (eval `(lambda ,(nth 2 refer) ,@(cdddr refer)) t))
                  :delegated)))))

(ert-deftest my-diario-priad-commands-manual-import-close-once ()
  (my-dpc-test--files
    (let ((visitor (current-buffer)) (calls 0))
      (cl-letf (((symbol-function 'my-diario-current) (lambda () target))
                ((symbol-function 'completing-read)
                 (lambda (prompt &rest _)
                   (should (string-prefix-p "Importar a:" prompt))
                   "DEEP")))
        (let ((original (symbol-function 'my-diario-import))
              (kill-buffer-query-functions
               (list #'my-dpc-maybe-on-kill)))
          (cl-letf (((symbol-function 'my-diario-import)
                     (lambda (&rest args)
                       (cl-incf calls)
                       (apply original args))))
            (let ((this-command 'kill-buffer))
              (should (my-dpc-copy 'new-only))))))
      (should (= calls 1))
      (should-not (buffer-live-p visitor))
      (should (string-match-p "\\*\\* TODO Cotización" (my-dpc-test--disk target)))
      (should-not (string-search "* TASKS" (my-dpc-test--disk target)))
      (should (string-search ":DIARIO_EXPORTS:" (my-dpc-test--disk source))))))

(ert-deftest my-diario-priad-commands-failure-and-cancel-leave-source-open ()
  (my-dpc-test--files
    (let ((visitor (current-buffer))
          (before (my-dpc-test--disk source)))
      (cl-letf (((symbol-function 'my-diario-current) (lambda () nil)))
        (should-error (my-dpc-copy) :type 'user-error))
      (should (buffer-live-p visitor))
      (should (equal before (my-dpc-test--disk source)))
      (goto-char (point-max))
      (insert "Cambio sin guardar.\n")
      (cl-letf (((symbol-function 'my-diario-current) (lambda () target))
                ((symbol-function 'y-or-n-p) (lambda (&rest _) nil)))
        (should-error (my-dpc-copy) :type 'user-error))
      (should (buffer-live-p visitor))
      (should (buffer-modified-p))
      (should (equal before (my-dpc-test--disk source))))))

